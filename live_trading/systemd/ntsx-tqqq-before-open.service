[Unit]
Description=NTSX/TQQQ before-open Alpaca rebalance dry-run

[Service]
Type=oneshot
WorkingDirectory=/opt/ntsx-tqqq
EnvironmentFile=/etc/ntsx-tqqq/alpaca.env
ExecStart=/opt/ntsx-tqqq/.venv/bin/python /opt/ntsx-tqqq/live_trading/run_before_open.py --config /opt/ntsx-tqqq/live_trading/config.toml --dry-run

